# LLM — Gemini is used only for free-text application questions
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Profile contact fields (used only if profile.json omits them)
USER_EMAIL=you@example.com
USER_PHONE=+91-0000000000
USER_LOCATION=Pune
USER_LINKEDIN=https://linkedin.com/in/your-profile
USER_GITHUB=https://github.com/your-handle
USER_PORTFOLIO=https://your-portfolio.example

# Portal credentials (used only for optional login hints; never logged)
INDEED_EMAIL=
INDEED_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
INTERNSHALA_EMAIL=
INTERNSHALA_PASSWORD=

# Runtime
HEADLESS=false
PAUSE_BEFORE_SUBMIT=true
FOLLOW_UP_DAYS=7
MAX_JOB_AGE_DAYS=21

# Job discovery — comma-separated source ids. First implemented source: indeed
DISCOVERY_ENABLED=true
JOB_SOURCES=indeed
JOB_SOURCE_COUNTRY=in
DISCOVERY_MAX_ROLES=3
DISCOVERY_MAX_LOCATIONS=2
DISCOVERY_MAX_SEARCHES=6
DISCOVERY_MAX_JOBS=30
DISCOVERY_HISTORY_FILE=./data/discovery-history.json

# Paths
PROFILE_PATH=./data/profile.json
JOBS_FILE=./data/jobs.xlsx
APPLICATIONS_FILE=./data/applications.xlsx
CONTACTS_FILE=./data/contacts.xlsx
STATE_FILE=./data/state.json
RESUME_FRONTEND=./resumes/frontend.pdf
RESUME_FULLSTACK=./resumes/fullstack.pdf
STORAGE_DIR=./storage
SCREENSHOTS_DIR=./screenshots
REPORTS_DIR=./reports
