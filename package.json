{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Personal CLI job-search assistant. Prepares applications; never auto-submits.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "jobs": "tsx src/index.ts jobs",
    "analyze": "tsx src/index.ts analyze",
    "prepare-apps": "tsx src/index.ts prepare",
    "review": "tsx src/index.ts review",
    "contacts": "tsx src/index.ts contacts",
    "followups": "tsx src/index.ts followups",
    "export": "tsx src/index.ts export",
    "mark-submitted": "tsx src/index.ts mark-submitted",
    "daily": "tsx src/index.ts daily",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "openai": "^4.77.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
